# PostgreSQL
POSTGRES_USER=auranet
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=auranet
DATABASE_URL=postgresql+asyncpg://auranet:replace-with-a-local-database-password@db:5432/auranet

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=auranet-local
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=auranet-media
MINIO_ACCESS_KEY=auranet-local
MINIO_SECRET_KEY=replace-with-a-local-minio-password
MINIO_PUBLIC_URL=http://localhost:9002

# RabbitMQ
RABBITMQ_DEFAULT_USER=auranet
RABBITMQ_DEFAULT_PASS=replace-with-a-local-rabbitmq-password
RABBITMQ_URL=amqp://auranet:replace-with-a-local-rabbitmq-password@rabbitmq:5672/

# JWT Auth
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Worker
AI_PROVIDER=mock
OPENAI_API_KEY=
